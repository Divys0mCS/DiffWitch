# ---- DiffWitch backend environment ----
# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Neon pooled connection string (Project -> Connection Details -> Pooled connection).
# Keep sslmode=require; it is translated for asyncpg automatically.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Only these origins may call the dashboard API (comma separated, no trailing slash).
FRONTEND_ORIGIN=http://localhost:3000

# ---- dashboard auth ----
DASHBOARD_PASSWORD=
SESSION_SECRET=

# ---- llm (Phase 2) ----
LLM_PROVIDER=gemini
# Exact model id from Google AI Studio, e.g. the id shown in the model picker.
LLM_MODEL=
GEMINI_API_KEY=
# Your real AI Studio limits for the chosen model:
LLM_RPM=5
LLM_RPD=20
DAILY_LLM_BUDGET=18

# ---- review behaviour ----
REVIEW_MODE=lite
MAX_AGENT_STEPS=3
MAX_PROMPT_CHARS=60000
MAX_FILE_DIFF_CHARS=12000
MAX_FILES_PER_REVIEW=40
MAX_INLINE_COMMENTS=25

# ---- github app (Phase 4) ----
GITHUB_APP_ID=
# base64 of the .pem file contents, one line (see docs/GITHUB_APP.md)
GITHUB_PRIVATE_KEY_B64=
GITHUB_WEBHOOK_SECRET=

# ---- worker ----
WORKER_ENABLED=true
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_SECONDS=2
JOB_MAX_ATTEMPTS=3
